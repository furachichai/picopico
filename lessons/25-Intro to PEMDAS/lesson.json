          "rotation": 0,
          "scale": 1,
          "metadata": {
            "options": [
              "<font face=\"Verdana, Arial, sans-serif\" style=\"font-size: 15px;\" color=\"#000000\">P<span style=\"font-weight: normal;\">laying </span>E<span style=\"font-weight: normal;\">pic </span>M<span style=\"font-weight: normal;\">inecraft </span>D<span style=\"font-weight: normal;\">estroys </span>A<span style=\"font-weight: normal;\">ll </span>S<span style=\"font-weight: normal;\">leep</span></font>",
              "<font face=\"Atkinson Hyperlegible Next\" style=\"font-size: 15px;\" color=\"#000000\">P<span style=\"font-weight: normal;\">arenthesis </span>E<span style=\"font-weight: normal;\">xponents </span>M<span style=\"font-weight: normal;\">ultiplication</span> D<span style=\"font-weight: normal;\">ivision </span>A<span style=\"font-weight: normal;\">ddition </span>S<span style=\"font-weight: normal;\">ubtraction</span></font><div><br></div>",
